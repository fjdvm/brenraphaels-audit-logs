# Required: Neon pooled connection URL for the audit_runtime role.
# Copy from Neon Connect after the migration creates audit_runtime and you set its password.
# Format: postgresql://audit_runtime:<password>@<pooled-host>/<database>?sslmode=require
DATABASE_URL=

# Required for setup and operator scripts: Neon direct connection URL for the database owner.
# Copy from Neon Connect with connection pooling disabled.
# Format: postgresql://<owner>:<password>@<direct-host>/<database>?sslmode=require
# Keep this credential in the operator environment, outside the deployed API runtime.
DATABASE_URL_MIGRATIONS=

# Required for the separate anonymization job: Neon connection URL for audit_anonymize.
# Set after the migration creates audit_anonymize and you assign its password.
# Format: postgresql://audit_anonymize:<password>@<direct-host>/<database>?sslmode=require
# Keep this credential in the job environment, outside the deployed API runtime.
DATABASE_URL_ANONYMIZE=

# Optional HTTP port; defaults to 3000.
PORT=3000
