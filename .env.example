# Neon pooled connection: audit_runtime (INSERT/SELECT events, SELECT keys)
DATABASE_URL=
# Neon direct owner connection: migrations and operator key creation/revocation
DATABASE_URL_MIGRATIONS=
# Neon connection: audit_anonymize (SELECT events, UPDATE personal columns only)
DATABASE_URL_ANONYMIZE=
PORT=3000
# Disposable migrated Postgres database used by Vitest; never use production.
TEST_DATABASE_URL=
TEST_DATABASE_URL_RUNTIME=

# Maximum authenticated requests per API key per second, per service instance.
RATE_LIMIT_PER_SECOND=100

# Optional direct anonymization connection for providers that prohibit SET ROLE.
TEST_DATABASE_URL_ANONYMIZE=
